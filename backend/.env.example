# ================================================================
# Velo Backend — переменные окружения
# Скопируйте в .env и заполните реальными значениями
# ================================================================

# Порт HTTP-сервера
PORT=3000

# ---------- Ed25519 (приватный ключ бэкенда) ----------
# Сгенерировать: npm run keygen
# Формат: HEX-строка (64 hex символа = 32 байта seed Ed25519)
ED25519_PRIVATE_KEY=

# ---------- 42 Intra OAuth 2.0 ----------
# Создать приложение: https://profile.intra.42.fr/oauth/applications
INTRA_UID=
INTRA_SECRET=
INTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---------- JWT (сессионные токены пользователей) ----------
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ---------- Firebase Firestore (опционально, для хранения аренд) ----------
# Оставить пустым — аренды хранятся в памяти (для MVP)
FIREBASE_SERVICE_ACCOUNT=